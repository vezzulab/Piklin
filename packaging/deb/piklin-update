#!/usr/bin/python3 -I
"""Install a newer, official Piklin. Installed as /usr/lib/piklin/piklin-update.

Piklin runs this through pkexec to update itself. A polkit rule lets the
person sitting at the computer run it without a password, so it is written
to do exactly one thing and nothing else:

  - it takes only a version number, never a file or a web address;
  - it downloads that version from Piklin's own releases on GitHub;
  - it accepts the package only if its checksum is signed with Vezzu Studio's
    release key (the public half ships in /usr/lib/piklin/release-key.pem),
    it really is Piklin, for this computer, at that version, and newer than
    the Piklin already installed.

Anything else is refused before apt is ever called.

    piklin-update VERSION                          install (as root)
    piklin-update --verify-only VERSION DIR [KEY]  check files already in DIR

Exit codes: 0 installed, 2 bad request, 3 not newer, 4 download failed,
5 package failed verification, 6 installation failed.
"""
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request

REPO = "vezzulab/Piklin"
KEY = "/usr/lib/piklin/release-key.pem"
MAX_BYTES = 1024 * 1024 * 1024
VERSION_RE = re.compile(r"^\d+(\.\d+){1,3}$")
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C.UTF-8",
       "DEBIAN_FRONTEND": "noninteractive"}


class Refused(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def run(args, **kw):
    return subprocess.run(args, env=ENV, capture_output=True, text=True, **kw)


def architecture():
    return run(["dpkg", "--print-architecture"]).stdout.strip()


def names(version, arch):
    deb = "piklin_%s_%s.deb" % (version, arch)
    return deb, deb + ".sha256", deb + ".sha256.sig"


def installed_version():
    out = run(["dpkg-query", "-W", "-f=${Version}", "piklin"])
    return out.stdout.strip() if out.returncode == 0 else ""


def newer(version, than):
    if not than:
        return True
    return run(["dpkg", "--compare-versions", version, "gt", than]).returncode == 0


def download(url, dest):
    req = urllib.request.Request(url, headers={"User-Agent": "Piklin-updater"})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp, open(dest, "wb") as out:
            total = 0
            while True:
                chunk = resp.read(1 << 20)
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_BYTES:
                    raise Refused(4, "download is too large")
                out.write(chunk)
    except Refused:
        raise
    except Exception as exc:
        raise Refused(4, "could not download %s: %s" % (url, exc))


def verify(folder, version, arch, key=KEY):
    """Raise Refused unless folder holds the signed, official package."""
    deb, manifest, sig = (os.path.join(folder, n) for n in names(version, arch))
    for path in (deb, manifest, sig):
        if not os.path.isfile(path):
            raise Refused(5, "missing %s" % os.path.basename(path))
    check = run(["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", key,
                 "-rawin", "-in", manifest, "-sigfile", sig])
    if check.returncode != 0 or "Signature Verified Successfully" not in check.stdout:
        raise Refused(5, "the signature does not match Vezzu Studio's release key")
    with open(manifest, encoding="utf-8") as f:
        text = f.read()
    match = re.fullmatch(r"([0-9a-f]{64})  (\S+)\n?", text)
    if not match or match.group(2) != os.path.basename(deb):
        raise Refused(5, "the checksum file is not for this package")
    digest = hashlib.sha256()
    with open(deb, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            digest.update(chunk)
    if digest.hexdigest() != match.group(1):
        raise Refused(5, "the package does not match its signed checksum")
    fields = run(["dpkg-deb", "-f", deb, "Package", "Version", "Architecture"])
    info = dict(line.split(": ", 1) for line in fields.stdout.splitlines() if ": " in line)
    if (info.get("Package"), info.get("Version"), info.get("Architecture")) != ("piklin", version, arch):
        raise Refused(5, "the package is not Piklin %s for %s" % (version, arch))
    return deb


def install(version):
    if os.geteuid() != 0:
        raise Refused(2, "must be run as root, through pkexec")
    arch = architecture()
    current = installed_version()
    if not newer(version, current):
        raise Refused(3, "Piklin %s is not newer than the installed %s" % (version, current))
    folder = tempfile.mkdtemp(prefix="piklin-update-", dir="/var/tmp")
    try:
        base = "https://github.com/%s/releases/download/v%s/" % (REPO, version)
        for name in names(version, arch):
            download(base + name, os.path.join(folder, name))
        deb = verify(folder, version, arch)
        # apt reads local packages as its own unprivileged user.
        os.chmod(folder, 0o755)
        os.chmod(deb, 0o644)
        result = run(["apt-get", "install", "-y", "-o", "DPkg::Lock::Timeout=300", deb])
        if result.returncode != 0:
            raise Refused(6, (result.stderr or result.stdout).strip()[-2000:])
    finally:
        shutil.rmtree(folder, ignore_errors=True)


def main(argv):
    try:
        if len(argv) >= 3 and argv[0] == "--verify-only":
            version, folder = argv[1], argv[2]
            if not VERSION_RE.match(version):
                raise Refused(2, "not a version number")
            verify(folder, version, architecture(), argv[3] if len(argv) > 3 else KEY)
            return 0
        if len(argv) != 1 or not VERSION_RE.match(argv[0]):
            raise Refused(2, "usage: piklin-update VERSION")
        install(argv[0])
        return 0
    except Refused as exc:
        sys.stderr.write("piklin-update: %s\n" % exc)
        return exc.code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
