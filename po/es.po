#: piklin/remote.py:956 piklin/remote.py:1313 piklin/remote.py:1328
#: piklin/remote.py:1793
msgid "Connected"
msgstr "Conectado"

#: piklin/remote.py:1289
msgid "Enter the server address"
msgstr "Escribe la dirección del servidor"

#: piklin/remote.py:1292
msgid "The address must start with https:// or http://"
msgstr "La dirección tiene que empezar con https:// o http://"

#: piklin/remote.py:1294
msgid "http:// only works at home"
msgstr "http:// solo funciona en casa"

#: piklin/remote.py:1295
msgid "Use https:// for a server on the internet, so your password stays private"
msgstr "Usa https:// para un servidor en internet, así tu contraseña queda protegida"

#. Not a missing password: the keyring isn't open yet, as
#. just after logging in. Waiting and trying again works.
#: piklin/remote.py:1304
msgid "The keyring is still locked"
msgstr "El llavero de contraseñas aún está bloqueado"

#: piklin/remote.py:1305
msgid "Piklin will try again in a few minutes"
msgstr "Piklin lo volverá a intentar en unos minutos"

#: piklin/remote.py:1307
msgid "No password saved"
msgstr "No hay contraseña guardada"

#: piklin/remote.py:1308
msgid "Edit this backup and enter the password again"
msgstr "Edita esta copia y vuelve a escribir la contraseña"

#: piklin/remote.py:1325
#, python-brace-format
msgid "Couldn't create the folder /{folder}"
msgstr "No se pudo crear la carpeta /{folder}"

#: piklin/remote.py:1326
#, python-brace-format
msgid "The server answered HTTP {code}. The folder must be inside a shared folder you can write to"
msgstr "El servidor respondió HTTP {code}. La carpeta tiene que estar dentro de una carpeta compartida donde puedas escribir"

#: piklin/remote.py:1329
#, python-brace-format
msgid "created the folder /{folder}"
msgstr "se creó la carpeta /{folder}"

#: piklin/remote.py:1340
msgid "Wrong username or password"
msgstr "Usuario o contraseña incorrectos"

#: piklin/remote.py:1340
msgid "Check the username and password"
msgstr "Revisa el usuario y la contraseña"

#: piklin/remote.py:1342
msgid "Not allowed"
msgstr "Sin permiso"

#: piklin/remote.py:1343
msgid "This account isn't allowed to use that folder"
msgstr "Esta cuenta no tiene permiso para usar esa carpeta"

#: piklin/remote.py:1345
msgid "This address doesn't accept backups"
msgstr "Esta dirección no acepta copias"

#: piklin/remote.py:1346
msgid "Turn on WebDAV on your server and use the address it shows for it. On a QNAP: Control Panel › Network & File Services › Win/Mac/NFS/WebDAV"
msgstr "Activa WebDAV en tu servidor y usa la dirección que muestra. En un QNAP: Panel de control › Servicios de red y archivos › Win/Mac/NFS/WebDAV"

#: piklin/remote.py:1351
msgid "The server says to use another address"
msgstr "El servidor indica que uses otra dirección"

#: piklin/remote.py:1352
#, python-brace-format
msgid "Try {address}"
msgstr "Prueba {address}"

#: piklin/remote.py:1354
msgid "This folder isn't on the server"
msgstr "Esta carpeta no está en el servidor"

#: piklin/remote.py:1355
msgid "Check the address and the folder"
msgstr "Revisa la dirección y la carpeta"

#: piklin/remote.py:1356
#, python-brace-format
msgid "The server answered HTTP {code}"
msgstr "El servidor respondió HTTP {code}"

#: piklin/remote.py:1361
msgid "The server's security certificate has changed"
msgstr "El certificado de seguridad del servidor cambió"

#: piklin/remote.py:1362
msgid "Trust the new one only if you replaced it yourself"
msgstr "Confía en el nuevo solo si lo cambiaste tú"

#: piklin/remote.py:1369
msgid "Confirm this server is yours"
msgstr "Confirma que este servidor es tuyo"

#: piklin/remote.py:1370
msgid "It uses its own security certificate, which is normal for a NAS at home"
msgstr "Usa su propio certificado de seguridad, algo normal en un NAS de casa"

#: piklin/remote.py:1372
msgid "A secure connection couldn't be made"
msgstr "No se pudo hacer una conexión segura"

#: piklin/remote.py:1373
msgid "Can't reach the server"
msgstr "No se puede conectar con el servidor"

#: piklin/remote.py:1689 piklin/remote.py:1776 piklin/remote.py:1806
#: piklin/remote.py:2301
msgid "rclone is not installed"
msgstr "rclone no está instalado"

#: piklin/remote.py:1691
msgid "Unknown cloud service"
msgstr "Servicio en la nube desconocido"

#: piklin/remote.py:1721
msgid "Signing in took too long. Try again."
msgstr "Iniciar sesión tardó demasiado. Inténtalo otra vez."

#: piklin/remote.py:1727
msgid "Signing in didn't finish"
msgstr "No se terminó de iniciar sesión"

#: piklin/remote.py:1777
msgid "Install rclone to use Google Drive, OneDrive, Dropbox, pCloud and more: sudo apt install rclone (then run: rclone config)"
msgstr "Instala rclone para usar Google Drive, OneDrive, Dropbox, pCloud y más: sudo apt install rclone (y luego ejecuta: rclone config)"

#: piklin/remote.py:1782
msgid "Enter the name of the cloud service"
msgstr "Escribe el nombre del servicio en la nube"

#: piklin/remote.py:1783
#, python-brace-format
msgid "Set up in rclone: {names}"
msgstr "Configurados en rclone: {names}"

#: piklin/remote.py:1784
msgid "none"
msgstr "ninguno"

#: piklin/remote.py:1794
msgid "rclone can't reach the cloud service"
msgstr "rclone no puede conectar con el servicio en la nube"

#: piklin/remote.py:1798
msgid "The cloud service took too long to answer"
msgstr "El servicio en la nube tardó demasiado en responder"

#: piklin/remote.py:1801
msgid "rclone failed"
msgstr "rclone falló"

#: piklin/remote.py:1809
msgid "Enter the name of the cloud service first"
msgstr "Primero escribe el nombre del servicio en la nube"

#: piklin/remote.py:1952
#, python-brace-format
msgid "rclone stopped with error {code}"
msgstr "rclone se detuvo con el error {code}"

#: piklin/remote.py:1992
msgid "rclone not installed"
msgstr "rclone no está instalado"

#: piklin/remote.py:2242
msgid "This backup is encrypted"
msgstr "Esta copia está cifrada"

#: piklin/remote.py:2243
msgid "Enter its recovery key on this computer to use it"
msgstr "Escribe su clave de recuperación en esta computadora para usarla"

#: piklin/remote.py:2262
msgid "This backup isn't encrypted"
msgstr "Esta copia no está cifrada"

#: piklin/remote.py:2264 piklin/ui/settings_dialog.py:699
msgid "The recovery key isn't on this computer"
msgstr "La clave de recuperación no está en esta computadora"

#: piklin/remote.py:2305
msgid "A recovery key has 32 letters and numbers. Check it and try again."
msgstr "Una clave de recuperación tiene 32 letras y números. Revísala y vuelve a intentarlo."

#: piklin/remote.py:2309
msgid "The recovery key couldn't be kept in your password manager, so the backup wasn't encrypted."
msgstr "La clave de recuperación no se pudo guardar en tu gestor de contraseñas, así que la copia no se cifró."

#: piklin/remote.py:2324
msgid "This recovery key doesn't open the encrypted backup there."
msgstr "Esta clave de recuperación no abre la copia cifrada que hay ahí."

#: piklin/remote.py:2432 piklin/ui/onboarding.py:361
#: piklin/ui/onboarding.py:394 piklin/ui/window.py:3946
msgid "Folder or Drive"
msgstr "Carpeta o unidad"

#: piklin/remote.py:2433
msgid "A USB drive, a network folder from your NAS, or a folder that Dropbox or pCloud Drive keeps in sync. No password needed."
msgstr "Una unidad USB, una carpeta de red de tu NAS o una carpeta que Dropbox o pCloud Drive sincronizan. No necesita contraseña."

