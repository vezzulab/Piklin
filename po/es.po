#, python-brace-format
msgid "There is already a file named “{name}” in that folder."
msgstr "Ya hay un archivo llamado “{name}” en esa carpeta."

#: piklin/photo_rename.py:83
#, python-brace-format
msgid "“{name}” is already in the library."
msgstr "“{name}” ya está en la biblioteca."

#: piklin/photo_rename.py:88
#, python-brace-format
msgid "This folder can't be changed: “{folder}”."
msgstr "Esta carpeta no se puede modificar: “{folder}”."

#: piklin/photo_rename.py:91
#, python-brace-format
msgid "The file couldn't be renamed: {error}."
msgstr "No se pudo cambiar el nombre del archivo: {error}."

#: piklin/photo_rename.py:103
msgid "The library couldn't be updated, so the file keeps its old name."
msgstr "No se pudo actualizar la biblioteca, así que el archivo mantiene su nombre anterior."

