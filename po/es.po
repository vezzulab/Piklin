#: piklin/compress.py:62 piklin/engine/tools.py:972
#: piklin/ui/export_dialog.py:144 piklin/ui/video_editor.py:34
msgid "Original"
msgstr "Original"

#: piklin/compress.py:63
msgid "Nothing is changed. Takes the most room."
msgstr "No se cambia nada. Es lo que más espacio ocupa."

#: piklin/compress.py:66
msgid "Exact Picture, Smaller File"
msgstr "Misma imagen, archivo más pequeño"

#: piklin/compress.py:67
msgid "The very same picture, packed more cleverly. Nothing at all is lost. Saves little on photographs, a lot on screenshots."
msgstr "La misma imagen, empaquetada con más ingenio. No se pierde nada. Ahorra poco en fotografías y mucho en capturas de pantalla."

#: piklin/compress.py:79
msgid "Looks the Same"
msgstr "Se ve igual"

#: piklin/compress.py:80
msgid "About half the room, and nobody can see the difference - not even side by side on a big screen."
msgstr "Más o menos la mitad del espacio, y nadie nota la diferencia, ni siquiera una al lado de la otra en una pantalla grande."

#: piklin/compress.py:85
msgid "Balanced"
msgstr "Equilibrado"

#: piklin/compress.py:86
msgid "About a third of the room. A difference you would only find by zooming right into a photo looking for it."
msgstr "Más o menos un tercio del espacio. Una diferencia que solo encontrarías acercando mucho la foto para buscarla."

#: piklin/compress.py:91
msgid "Space Saver"
msgstr "Ahorro de espacio"

#: piklin/compress.py:92
msgid "About a quarter of the room. Still good to look at and to share; fine detail softens."
msgstr "Más o menos la cuarta parte del espacio. Se ve bien y se puede compartir; el detalle fino se suaviza."

#: piklin/compress.py:97
msgid "Smallest Files"
msgstr "Archivos mínimos"

#: piklin/compress.py:98
msgid "The least room possible. Photos are also made smaller in size, so this is for keeping memories, not for printing them."
msgstr "El menor espacio posible. Además las fotos se hacen de menor tamaño, así que es para guardar recuerdos, no para imprimirlos."

#: piklin/compress.py:380
msgid "kept as-is"
msgstr "se deja tal cual"

#: piklin/compress.py:386
#, python-brace-format
msgid "can't read the file ({error})"
msgstr "no se puede leer el archivo ({error})"

#: piklin/compress.py:404
msgid "lossless would be larger; original kept"
msgstr "sin pérdida ocuparía más; se deja el original"

#: piklin/compress.py:425
msgid "no ladder step met the target; used highest quality"
msgstr "no se alcanzó el objetivo; se usó la máxima calidad"

#: piklin/compress.py:429 piklin/compress.py:436
#, python-brace-format
msgid "couldn't save the file ({error})"
msgstr "no se pudo guardar el archivo ({error})"

#: piklin/compress.py:443
msgid "already well compressed; original kept"
msgstr "ya estaba bien comprimido; se deja el original"

#: piklin/compress.py:446
#, python-brace-format
msgid "made smaller, up to {size} px on the long side"
msgstr "reducido a {size} px como máximo en el lado largo"

#: piklin/compress.py:478
msgid "copied unchanged"
msgstr "copiado sin cambios"

#: piklin/compress.py:521
msgid "original was already smaller; copied unchanged"
msgstr "el original ya era más pequeño; copiado sin cambios"

