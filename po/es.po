msgid "Passwords"
msgstr "Contraseñas"

#: piklin/ui/settings_dialog.py:449
msgid "Saved safely in your computer's password manager."
msgstr "Se guardan con seguridad en el gestor de contraseñas de tu ordenador."

#: piklin/ui/settings_dialog.py:450
msgid "This computer has no password manager, so only folders and drives can be used."
msgstr "Este ordenador no tiene gestor de contraseñas, así que solo se pueden usar carpetas y unidades."

