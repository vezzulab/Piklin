#: piklin/compress.py:63
msgid "Keeps your files exactly as they are."
msgstr "Deja tus archivos tal como están."

#: piklin/compress.py:66
msgid "Exact Picture, Smaller File"
msgstr "Misma imagen, archivo más pequeño"

#: piklin/compress.py:67
msgid "Exactly the same picture in a smaller file. Saves the most on screenshots."
msgstr "Exactamente la misma imagen en un archivo más pequeño. Ahorra más en capturas de pantalla."

#: piklin/compress.py:79
msgid "Looks the Same"
msgstr "Se ve igual"

#: piklin/compress.py:80
msgid "Much smaller files that look the same to the eye. Usually about half the size."
msgstr "Archivos mucho más pequeños que a simple vista se ven igual. Suelen ocupar la mitad."

#: piklin/compress.py:85
msgid "Balanced"
msgstr "Equilibrado"

