msgid "NAS or Server (WebDAV)"
msgstr "NAS o servidor (WebDAV)"

#: piklin/remote.py:2436
msgid "For QNAP, Synology, Nextcloud and similar. You need the server address, your username and your password."
msgstr "Para QNAP, Synology, Nextcloud y similares. Necesitas la dirección del servidor, tu usuario y tu contraseña."

#: piklin/remote.py:2438 piklin/ui/onboarding.py:365
#: piklin/ui/onboarding.py:395 piklin/ui/settings_dialog.py:782
#: piklin/ui/window.py:3944
msgid "Cloud Service"
msgstr "Servicio en la nube"

#: piklin/remote.py:2439
