#, python-brace-format
msgid "A file name can't contain {characters}"
msgstr "Un nombre de archivo no puede contener {characters}"

#: piklin/photo_rename.py:46
msgid "A name starting with a dot would hide the photo."
msgstr "Un nombre que empieza con punto ocultaría la foto."

#: piklin/photo_rename.py:48
msgid "That name is too long."
msgstr "Ese nombre es demasiado largo."

#: piklin/photo_rename.py:67
msgid "That photo is no longer in the library."
msgstr "Esa foto ya no está en la biblioteca."

#: piklin/photo_rename.py:70
#, python-brace-format
msgid "“{name}” isn't on this computer. Is its drive connected?"
msgstr "“{name}” no está en este ordenador. ¿Está conectada su unidad?"

